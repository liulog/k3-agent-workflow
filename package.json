{
  "name": "k3-agent-workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local asynchronous Pi build/test orchestration (hardware-free demo)",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "start": "node src/cli.ts serve",
    "demo": "node scripts/demo.ts",
    "plan:check": "node src/cli.ts check-plan --plan-config planning.example.json",
    "plan:demo": "node scripts/plan-experiment.ts --config planning.example.json",
    "test": "node --test tests/*.test.ts",
    "test:contracts": "python3 tests/real_contracts.py && python3 tests/reboot_guard.py && python3 tests/reliability.py"
  },
  "keywords": ["pi-package"],
  "pi": { "extensions": ["./extension/index.ts"] },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  }
}
